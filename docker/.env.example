# Metria Docker 部署示例配置
# 复制为 .env 后按需修改。

# --- Hub ---
METRIA_HTTP_PORT=8080
METRIA_TIMEZONE=Asia/Shanghai
METRIA_CONTENT_MODE=metadata
# 会话签名密钥（请替换为随机高强度字符串，修改后已有会话会失效）
METRIA_SESSION_SECRET=replace-with-a-random-secret
# 可选：跨平台 Agent 二进制目录或 Release 下载根地址
# METRIA_AGENT_BINARIES_DIR=/opt/metria/agent-binaries
# METRIA_AGENT_DOWNLOAD_BASE_URL=https://github.com/SuPerCxyz/metria/releases/latest/download
# 单 Admin 初始凭据（请部署后立即修改）
METRIA_ADMIN_USER=admin
METRIA_ADMIN_PASSWORD=change-me-please

# --- Agent ---
# 与宿主用户对齐，确保能读取 700 权限的 home 目录
UID=1000
GID=1000
METRIA_NODE_ID=node-01
METRIA_NODE_NAME=node-01
# 客户端数据目录（宿主路径，只读挂载）
CLAUDE_PATH=/home/example/.claude
CODEX_PATH=/home/example/.codex
OPENCODE_PATH=/home/example/.local/share/opencode
METRIA_HUB_URL=http://localhost:8080
METRIA_LOG=info
